# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_inventory?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# SMS / OTP Provider (example for SMS.ir or similar)
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_LINE_NUMBER=

# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Image Storage (local for now)
UPLOAD_DIR=./uploads
IMAGE_QUALITY=80

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
