{
  "name": "car-inventory-system",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Car Inventory & Smart Recommendation System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @car-inventory/infrastructure prisma:generate",
    "db:migrate": "pnpm --filter @car-inventory/infrastructure prisma:migrate",
    "db:deploy": "pnpm --filter @car-inventory/infrastructure prisma:deploy",
    "db:studio": "pnpm --filter @car-inventory/infrastructure prisma:studio",
    "setup": "bash scripts/setup-dev.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=20"
  }
}
